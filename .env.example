# TRINETRA Root Environment Configuration Example
# Copy to .env and populate strong unique secrets before running docker compose up

POSTGRES_DB=pulsescope
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password

REDIS_PASSWORD=replace-with-strong-redis-password

APP_KEY=
APP_PREVIOUS_KEYS=
APP_URL=https://media.antiquetech.web.id
CORS_ALLOWED_ORIGINS=https://media.antiquetech.web.id
NLP_SERVICE_URL=http://nlp:8001

NINE_ROUTER_BASE_URL=http://bappisus-9router-1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ag/gemini-3.8-flash-medium
NLP_ENABLE_DOCS=false
NLP_CORS_ORIGINS=http://backend:8000

# Optional External Connector Credentials
YOUTUBE_API_KEY=
RAPIDAPI_KEY=

# Muse Official Meta Collector Bridge (Phase 1: Threads, Facebook, Instagram)
# Supports comma-separated keys for zero-downtime key rotation
TRINETRA_API_KEY=
TRINETRA_MUSE_WORKSPACE_ID=
TRINETRA_INGEST_RATE_LIMIT=10

